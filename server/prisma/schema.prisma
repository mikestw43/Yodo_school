// YODO database (SQLite, one file in DATA_DIR).
// Ids are text UUIDs so records brought over from the old Lovable app keep their ids.
// Dates are "YYYY-MM-DD" strings so time zones can never shift them.
// Lists (interested classes, specialisations) are JSON text.
// Pictures are files in DATA_DIR/uploads; the column holds "/api/files/<name>" (or "").
// NOTE: deploys run `prisma db push` WITHOUT --accept-data-loss, so columns
// can be added but never dropped or renamed. Think twice before adding a field.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique // lowercase
  passwordHash String
  role         String    @default("user") // superadmin | user
  firstName    String    @default("")
  lastName     String    @default("")
  nickname     String    @default("")
  email        String    @default("")
  phone        String    @default("")
  positionId   String?
  image        String    @default("")
  status       String    @default("Active") // Active | Disabled
  tokenVersion Int       @default(0) // bump to sign the user out everywhere
  lang         String    @default("en") // th | en (owner 12/10/2026: English first)
  theme        String    @default("light")
  lastLoginAt  DateTime?
  googleSub    String? // Google account id, linked at the first Google sign-in
  noticeOff    String    @default("") // notice kinds this person turned off, comma separated (enrollment,schedule,expiry)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Position {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  isSystem    Boolean  @default(false) // full access, cannot be edited
  kind        String   @default("") // superadmin (hidden, Dev) | owner | partner | admin | "" = a role the Owner added
  createdAt   DateTime @default(now())
}

model PositionPermission {
  positionId String
  menuKey    String
  canView    Boolean @default(false)
  canAdd     Boolean @default(false)
  canEdit    Boolean @default(false)
  canDelete  Boolean @default(false)

  @@id([positionId, menuKey])
}

model Teacher {
  id              String    @id @default(uuid())
  image           String    @default("")
  prefix          String    @default("")
  firstName       String
  lastName        String    @default("")
  nickname        String    @default("")
  phone           String    @default("")
  email           String    @default("")
  lineId          String    @default("")
  specializations String    @default("[]")
  status          String    @default("Active")
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
}

model DanceClass {
  id          String   @id @default(uuid())
  name        String
  teacherId   String?
  description String   @default("")
  image       String   @default("")
  status      String   @default("Active") // Active | Inactive
  disabled    Boolean  @default(false)
  price       Float? // baht for the whole course (owner 12/10/2026; was per month)
  months      Int      @default(1) // course length in months; the expiry date follows from it
  weeks       Int      @default(0) // plus weeks (owner 25/10/2026: "3 months 2 weeks")
  days        String   @default("") // class days, "mon,wed,sat" (owner 25/10/2026)
  startTime   String   @default("") // "17:00", one time for every class day
  endTime     String   @default("")
  createdAt   DateTime @default(now())
}

model Student {
  id               String    @id @default(uuid())
  code             String    @unique // YDO00001, never reused
  prefix           String    @default("")
  firstName        String
  lastName         String    @default("")
  nickname         String    @default("")
  dob              String    @default("")
  nationality      String    @default("")
  nationalityOther String    @default("")
  religion         String    @default("")
  religionOther    String    @default("") // typed when religion is "Other"
  ethnicity        String    @default("") // เชื้อชาติ (added 12/10/2026)
  ethnicityOther   String    @default("") // typed when ethnicity is "Other"
  address          String    @default("")
  phone            String    @default("")
  email            String    @default("")
  lineId           String    @default("")
  emergencyName    String    @default("")
  emergencyPhone   String    @default("")
  relationship     String    @default("")
  image            String    @default("")
  interested       String    @default("[]")
  hasExperience    Boolean   @default(false)
  experienceDetail String    @default("")
  source           String    @default("") // one or more, joined with ", " (e.g. "Facebook, Friends")
  sourceOther      String    @default("")
  status           String    @default("Active")
  signature        String    @default("")
  signedAt         String    @default("")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
}

model Enrollment {
  id           String   @id @default(uuid())
  studentId    String
  classId      String
  joinedAt     DateTime @default(now())
  purchaseDate String   @default("")
  startDate    String   @default("")
  expiryDate   String   @default("")
  remark       String   @default("")
  receiptImage String   @default("")

  @@unique([studentId, classId])
}

model Schedule {
  id        String   @id @default(uuid())
  classId   String
  date      String
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  @@index([date])
}

model ScheduleStudent {
  scheduleId String
  studentId  String

  @@id([scheduleId, studentId])
}

// Same shape as the old app's audit log, so its page shows old and new data the same way.
// tableName/oldData/newData use the old app's snake_case column names.
model AuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  actorId     String?
  actorName   String   @default("")
  action      String // insert | update | delete | login | logout
  tableName   String
  recordId    String   @default("")
  recordLabel String   @default("")
  oldData     String?
  newData     String?

  @@index([createdAt])
}

// What the bell shows: one row per person, so reading on one device clears it everywhere.
model Notice {
  id        Int       @id @default(autoincrement())
  userId    String
  kind      String // enrollment | schedule | expiry | test
  ref       String    @default("")
  title     String
  body      String    @default("")
  url       String    @default("/")
  readAt    DateTime?
  deletedAt DateTime? // removed from the bell by its person; always read too
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Expiry warnings are made once per enrollment and expiry date.
model NoticeKey {
  key       String   @id
  createdAt DateTime @default(now())
}

model PushDevice {
  id        Int       @id @default(autoincrement())
  userId    String
  endpoint  String    @unique
  p256dh    String
  auth      String
  label     String    @default("")
  createdAt DateTime  @default(now())
  lastOkAt  DateTime?

  @@index([userId])
}

// ---------- sign-in: PIN, Face ID, Google (added 12/10/2026, copied from FinHR) ----------
// School-wide settings (one row, id 1). The Google client ID is public (not a secret).
model Setting {
  id             Int      @id @default(1)
  googleClientId String   @default("")
  expiryDays     Int      @default(7) // "class ending soon" warning, days before the expiry date
  // Company details printed on receipts (owner 12/10/2026, "Company settings" page)
  companyName    String   @default("")
  companyNameEn  String   @default("")
  companyAddress String   @default("")
  companyPhone   String   @default("")
  companyEmail   String   @default("")
  companyTaxId   String   @default("")
  companyBranch  String   @default("")
  receiptLogo    String   @default("") // "" = the YODO logo
  receiptSign    String   @default("") // signature of the person receiving money, optional
  receiptStamp   String   @default("") // company stamp printed beside the signature, optional (owner 12/10/2026)
  receiptSignName String  @default("") // receiver's name printed under the signature on receipts (owner 12/10/2026)
  // Sending receipts by email through the school's Gmail (owner 13/10/2026). The app password is typed in by the owner
  // on the Company settings page and kept encrypted (lib/crypto.ts); only its last 4 characters are ever shown.
  mailUser        String  @default("")
  mailFromName    String  @default("")
  mailPass        String  @default("")
  updatedAt      DateTime @updatedAt
}

// Face ID / fingerprint (WebAuthn passkeys).
model Passkey {
  id           Int       @id @default(autoincrement())
  userId       String
  credentialId String    @unique // base64url
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String    @default("")
  deviceName   String    @default("")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  deletedAt    DateTime?

  @@index([userId])
}

// A PIN set on one device: works only with that device's secret (httpOnly cookie), only hashes kept.
model DevicePin {
  id         Int       @id @default(autoincrement())
  userId     String
  tokenHash  String    @unique
  pinHash    String
  fails      Int       @default(0)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

// Receipts for class purchases (owner 12/10/2026). Number RC + YYMM + "-" + 4 digits, restarting each month, never
// skipped: a receipt is never deleted, only cancelled (kept, shown struck through, not counted).
model Receipt {
  id             String    @id @default(uuid())
  no             String    @unique // RC2610-0001
  ym             String // "2610" (year + month of the receipt date)
  seq            Int
  date           String // YYYY-MM-DD, the day the money came in
  studentId      String
  enrollmentId   String    @default("")
  classId        String    @default("")
  item           String // class name at the time
  months         Int       @default(1)
  weeks          Int       @default(0)
  startDate      String    @default("")
  expiryDate     String    @default("")
  price          Float
  discount       Float     @default(0)
  amount         Float
  method         String // cash | transfer | card
  slip           String    @default("")
  payer          String    @default("")
  remark         String    @default("")
  receivedById   String    @default("")
  receivedByName String    @default("")
  cancelledAt    DateTime?
  cancelReason   String    @default("")
  cancelledBy    String    @default("")
  createdAt      DateTime  @default(now())

  @@unique([ym, seq])
}

// One course bought (a receipt line, or a purchase without payment) or one free extension (owner 12/10/2026,
// mockup WTr5LoqwQAEnSrKDuzZiMi). The student's history; the Enrollment keeps the current period.
model CoursePurchase {
  id            String    @id @default(uuid())
  studentId     String
  classId       String
  enrollmentId  String
  kind          String // buy | extend
  date          String // YYYY-MM-DD: paid / extended on
  item          String    @default("") // class name at the time
  months        Int       @default(0)
  weeks         Int       @default(0)
  startDate     String    @default("")
  expiryDate    String    @default("")
  fromStart     String    @default("") // the enrollment's period before this row (to undo a cancelled receipt)
  fromExpiry    String    @default("")
  price         Float     @default(0)
  discountType  String    @default("baht") // baht | pct
  discountValue Float     @default(0)
  discount      Float     @default(0) // baht
  amount        Float     @default(0)
  receiptId     String    @default("")
  reason        String    @default("") // extension reason
  byName        String    @default("")
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([studentId])
  @@index([enrollmentId])
  @@index([receiptId])
}

// A receipt sent by email (owner 13/10/2026): to whom, in which language, by whom.
model ReceiptEmail {
  id        String   @id @default(uuid())
  receiptId String
  to        String
  lang      String
  byName    String   @default("")
  createdAt DateTime @default(now())

  @@index([receiptId])
}

// "Chat with support" (owner 25/10/2026, mockup D1GCdHAfNmKbMkrNXQBjed): one conversation per person (`userId`), answered by
// the SuperAdmin. page/device/version are filled in by the app and shown only to the SuperAdmin.
model SupportMessage {
  id        String    @id @default(uuid())
  userId    String // whose conversation
  fromAdmin Boolean   @default(false)
  byId      String // who wrote it
  text      String    @default("")
  image     String    @default("")
  page      String    @default("")
  device    String    @default("")
  version   String    @default("")
  readAt    DateTime? // read by the other side
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
